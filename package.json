{
  "name": "@yartu/ui-kit",
  "description": "Yartu UI Kit for Developers w/ Vue3+Tailwind",
  "version": "1.0.0-beta.218",
  "author": "Yartu Information Technologies AS <info@yartu.io> (https://www.yartu.io)",
  "bugs": {
    "url": "https://github.com/yartu/yartu-ui-kit/issues",
    "email": "info@yartu.io"
  },
  "contributors": [
    "Yartu Information Technologies AS <info@yartu.io> (https://www.yartu.io)",
    "Ahmet Küçük <ahmet@yartu.io>",
    "Umut Kenar <umut@yartu.io>"
  ],
  "private": false,
  "scripts": {
    "build": "NODE_ENV=production npm run build-app && npm run build-css",
    "build-app": "vue-cli-service build --target lib --name yartu index.js",
    "build-css": "tailwind build -m -i ./dist/yartu.css -o ./dist/yart.min.css",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.18",
    "@vueuse/core": "^11.3.0",
    "core-js": "^3.45.1",
    "dayjs": "^1.11.18",
    "maska": "^2.1.11",
    "postcss": "^8.5.6",
    "tailwind-scrollbar-hide": "^1.3.1",
    "tailwindcss": "^3.4.17",
    "vue": "^3.3.7"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "^5.0.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0"
  },
  "main": "./index.js",
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "homepage": "https://github.com/yartu/yartu-ui-kit",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yartu/yartu-ui-kit"
  }
}
